# SimpleMd4PHP — send every request to index.php

DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Hide dotfiles and dot-folders (.git, .cache, .env …), except .well-known
    RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]

    # Serve real static files (images, css, downloads) directly — but never raw .md
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_FILENAME} !\.md$ [NC]
    RewriteRule ^ - [L]

    # Everything else is a page
    RewriteRule ^ index.php [L]
</IfModule>

# Compress pages and text assets
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# Let browsers keep static assets for a while (pages revalidate via ETag)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png  "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif  "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css   "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
